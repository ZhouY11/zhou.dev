---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);

posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="Blog | Zhou" description="Frontend engineering and AI development notes.">
  <section class="mx-auto max-w-4xl px-6 py-24">
    <div class="mb-14">
      <p class="mb-3 text-sm font-medium text-indigo-400">BLOG</p>

      <h1 class="text-4xl font-bold tracking-tight">Notes & Articles</h1>

      <p class="mt-4 text-zinc-400">关于前端架构、工程化、性能优化和 AI 的一些记录。</p>
    </div>

    <div class="space-y-4">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="block rounded-2xl border border-white/10 p-6 transition hover:border-white/20 hover:bg-white/[0.03]"
          >
            <div class="mb-3 flex gap-2">
              {post.data.tags.map((tag) => (
                <span class="text-xs text-indigo-400">#{tag}</span>
              ))}
            </div>

            <h2 class="text-xl font-semibold">{post.data.title}</h2>

            <p class="mt-2 text-zinc-400">{post.data.description}</p>

            <time class="mt-5 block text-sm text-zinc-600">
              {post.data.pubDate.toLocaleDateString('zh-CN')}
            </time>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
