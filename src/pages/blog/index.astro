---
import BlogCard from '../../components/blog/BlogCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="记录前端架构、工程化、性能优化与 AI Agent 开发实践。">
  <section class="mx-auto max-w-4xl px-6 py-24">
    <header class="mb-14">
      <p class="mb-3 text-sm font-medium tracking-widest text-indigo-400 uppercase">Blog</p>

      <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">Notes & Articles</h1>

      <p class="mt-5 max-w-2xl leading-7 text-zinc-400">
        关于前端架构、工程化、性能优化以及 AI Agent 的实践与思考。
      </p>
    </header>

    {
      posts.length > 0 ? (
        <div class="space-y-4">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <p class="text-zinc-500">暂时还没有发布文章。</p>
      )
    }
  </section>
</BaseLayout>
