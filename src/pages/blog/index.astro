---
import BlogCard from '../../components/blog/BlogCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="记录前端架构、工程化、性能优化与 AI Agent 开发实践。">
  <div class="mx-auto max-w-4xl px-6 py-24">
    <section aria-labelledby="blog-title">
      <p class="text-sm font-medium tracking-[0.18em] text-fg-subtle uppercase">Blog</p>

      <h1
        id="blog-title"
        class="mt-6 max-w-4xl text-4xl leading-[1.08] font-semibold tracking-[-0.035em] text-fg sm:text-5xl lg:text-7xl"
      >
        Notes &
        <span class="text-fg-muted"> Articles</span>
      </h1>

      <p class="mt-10 text-base leading-8 text-fg-muted sm:text-lg">
        关于前端架构、工程化、性能优化以及 AI Agent 的实践与思考。
      </p>

      <nav class="mt-8 flex flex-wrap gap-2" aria-label="博客内容浏览">
        <a
          href="/blog"
          aria-current="page"
          class="rounded-full focus-ring bg-fg px-4 py-2 text-sm font-medium text-bg"
        >
          全部文章
        </a>

        <a
          href="/blog/tags"
          class="rounded-full border focus-ring border-border px-4 py-2 text-sm text-fg-muted transition-colors hover:text-fg"
        >
          标签
        </a>

        <a
          href="/blog/series"
          class="rounded-full border focus-ring border-border px-4 py-2 text-sm text-fg-muted transition-colors hover:text-fg"
        >
          系列
        </a>
      </nav>
    </section>

    {
      posts.length > 0 ? (
        <div class="mt-18 space-y-4 sm:mt-22">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-18 text-xl text-fg-subtle sm:mt-22">暂时还没有发布文章。</p>
      )
    }
  </div>
</BaseLayout>
