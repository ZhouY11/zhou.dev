---
import AboutTeaser from '@/components/home/AboutTeaser.astro';
import ClosingCTA from '@/components/home/ClosingCTA.astro';
import Hero from '@/components/home/Hero.astro';
import SelectedProjects from '@/components/home/SelectedProjects.astro';
import SelectedWriting from '@/components/home/SelectedWriting.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFeaturedPosts } from '@/lib/blog';
import { getFeaturedProjects } from '@/lib/projects';

const featuredPosts = await getFeaturedPosts(3);
const featuredProjects = await getFeaturedProjects(3);
---

<BaseLayout>
  <Hero />

  <SelectedProjects projects={featuredProjects} />

  <SelectedWriting posts={featuredPosts} />

  <AboutTeaser />

  <ClosingCTA />
</BaseLayout>
