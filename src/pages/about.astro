---
import BaseLayout from '@/layouts/BaseLayout.astro';

const principles = [
  {
    number: '01',
    title: '先理解问题，再选择技术',
    description:
      '框架和工具只是实现手段。我更关注问题边界、长期维护成本，以及方案是否真正匹配业务。',
  },
  {
    number: '02',
    title: '让复杂度停留在正确的位置',
    description:
      '好的架构不是消灭复杂度，而是建立清晰边界，让业务、基础设施和交互能力各自承担自己的职责。',
  },
  {
    number: '03',
    title: '用数据验证工程判断',
    description:
      '性能优化、构建优化和架构调整都应该建立在实际问题和可观测结果之上，而不是为了技术本身进行优化。',
  },
];

const focuses = [
  'Frontend Architecture',
  'Engineering',
  'Performance',
  'Developer Experience',
  'AI Agent',
];
---

<BaseLayout
  title="关于"
  description="关于 Zhou，一名前端工程师，以及我对前端架构、工程化、性能优化和 AI Agent 的持续探索。"
>
  <div class="mx-auto max-w-4xl px-6 py-24">
    <!-- Intro -->
    <section aria-labelledby="about-title">
      <p class="text-sm font-medium tracking-[0.18em] text-fg-subtle uppercase">About</p>

      <h1
        id="about-title"
        class="mt-6 max-w-4xl text-4xl leading-[1.08] font-semibold tracking-[-0.035em] text-fg sm:text-5xl lg:text-7xl"
      >
        我喜欢把复杂的问题，
        <span class="text-fg-muted"> 拆成可以长期维护的系统。 </span>
      </h1>

      <div
        class="mt-10 grid gap-6 text-base leading-8 text-fg-muted sm:text-lg lg:grid-cols-[1.35fr_0.65fr] lg:gap-16"
      >
        <div class="max-w-2xl space-y-5">
          <p>你好，我是 Zhou，一名前端工程师。</p>

          <p>
            我的工作长期围绕复杂前端系统展开，包括平台架构、微前端、
            工程化、构建体系与性能优化。相比单纯完成页面，我更感兴趣的是：
            当业务规模持续增长以后，系统应该如何保持清晰、稳定和可演进。
          </p>

          <p>
            最近，我也在持续学习 AI Agent
            的工程实践，希望把过去积累的前端工程能力延伸到新的应用开发范式中。
          </p>
        </div>

        <aside class="border-t border-border pt-6 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
          <p class="text-xs font-medium tracking-[0.16em] text-fg-subtle uppercase">
            Currently exploring
          </p>

          <ul class="mt-5 flex flex-wrap gap-2">
            {
              focuses.map((focus) => (
                <li class="rounded-full border border-border bg-bg-elevated px-3 py-1.5 text-xs text-fg-muted">
                  {focus}
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>

    <!-- Engineering principles -->
    <section
      class="mt-28 border-t border-border pt-16 sm:mt-32 sm:pt-20"
      aria-labelledby="engineering-title"
    >
      <p class="text-sm font-medium tracking-[0.18em] text-fg-subtle uppercase">Engineering</p>

      <h2
        id="engineering-title"
        class="mt-5 max-w-3xl text-3xl font-semibold tracking-tight text-fg sm:text-4xl"
      >
        我更关注技术决策背后的理由。
      </h2>

      <div class="mt-12 grid gap-8 lg:grid-cols-3 lg:gap-10">
        {
          principles.map((principle) => (
            <article class="border-t border-border pt-6">
              <span class="text-xs text-fg-subtle">{principle.number}</span>

              <h3 class="mt-5 text-lg font-medium text-fg">{principle.title}</h3>

              <p class="mt-3 text-sm leading-7 text-fg-muted">{principle.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Experience -->
    <section
      class="mt-28 border-t border-border pt-16 sm:mt-32 sm:pt-20"
      aria-labelledby="experience-title"
    >
      <div class="grid gap-10 lg:grid-cols-[0.65fr_1.35fr] lg:gap-20">
        <div>
          <p class="text-sm font-medium tracking-[0.18em] text-fg-subtle uppercase">Experience</p>

          <h2
            id="experience-title"
            class="mt-5 text-3xl font-semibold tracking-tight text-fg sm:text-4xl"
          >
            从业务开发，到系统设计。
          </h2>
        </div>

        <div class="space-y-6 text-base leading-8 text-fg-muted">
          <p>
            多年的前端开发经历让我逐渐从关注单个页面，
            转向关注应用之间的边界、团队协作方式以及系统长期演进的问题。
          </p>

          <p>
            我参与和推动过微前端平台改造、审批能力统一、 前端工程规范以及复杂业务模块建设。
            这些经历让我越来越重视架构设计与真实业务收益之间的关系。
          </p>
        </div>
      </div>
    </section>

    <!-- Now -->
    <section
      class="mt-28 border-t border-border pt-16 sm:mt-32 sm:pt-20"
      aria-labelledby="now-title"
    >
      <p class="text-sm font-medium tracking-[0.18em] text-fg-subtle uppercase">Now</p>

      <h2
        id="now-title"
        class="mt-5 max-w-3xl text-3xl font-semibold tracking-tight text-fg sm:text-4xl"
      >
        继续写代码，也继续拓宽技术边界。
      </h2>

      <p class="mt-6 max-w-2xl text-base leading-8 text-fg-muted">
        目前我仍然保持一线开发，同时持续学习 React、Astro 和 AI Agent
        开发，并通过这个网站记录真实的学习和工程实践。
      </p>
    </section>

    <!-- Connect -->
    <section
      class="mt-28 border-t border-border pt-16 sm:mt-32 sm:pt-20"
      aria-labelledby="connect-title"
    >
      <h2
        id="connect-title"
        class="max-w-3xl text-3xl font-semibold tracking-tight text-fg sm:text-4xl"
      >
        想继续了解我？
      </h2>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/blog"
          class="inline-flex min-h-11 items-center rounded-full focus-ring bg-fg px-5 py-2.5 text-sm font-medium text-bg transition-transform hover:-translate-y-0.5 motion-reduce:transform-none"
        >
          阅读博客
          <span class="ml-2" aria-hidden="true">→</span>
        </a>

        <a
          href="/#projects"
          class="inline-flex min-h-11 items-center rounded-full border focus-ring border-border px-5 py-2.5 text-sm font-medium text-fg-muted transition-colors hover:text-fg"
        >
          查看项目
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
