---
import type { CollectionEntry } from 'astro:content';

import { formatDate } from '../lib/date';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  olderPost?: CollectionEntry<'blog'>;
  newerPost?: CollectionEntry<'blog'>;

  ogImage?: string;
}

const { post, olderPost, newerPost, ogImage } = Astro.props;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  ogImage={ogImage}
  ogImageAlt={`${post.data.title} 的文章分享预览图`}
>
  <article class="mx-auto max-w-3xl px-6 py-24">
    <header class="mb-14">
      <div class="mb-5 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => <span class="text-sm font-medium text-brand">#{tag}</span>)}
      </div>

      <h1 class="text-4xl leading-tight font-semibold tracking-tight text-fg sm:text-5xl">
        {post.data.title}
      </h1>

      <p class="mt-6 text-lg leading-8 text-fg-muted">
        {post.data.description}
      </p>

      <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm text-fg-subtle">
        <time datetime={post.data.publishedAt.toISOString()}>
          发布于 {formatDate(post.data.publishedAt)}
        </time>

        {
          post.data.updatedAt && (
            <time datetime={post.data.updatedAt.toISOString()}>
              更新于 {formatDate(post.data.updatedAt)}
            </time>
          )
        }
      </div>
    </header>

    <div
      class="prose max-w-none prose-zinc dark:prose-invert prose-headings:scroll-mt-24 prose-a:text-brand prose-pre:border prose-pre:border-border"
    >
      <slot />
    </div>

    {
      (newerPost || olderPost) && (
        <nav
          class="mt-16 grid gap-4 border-t border-border pt-8 sm:grid-cols-2"
          aria-label="文章导航"
        >
          <div>
            {newerPost && (
              <a
                href={`/blog/${newerPost.id}`}
                class="group block rounded-xl border focus-ring border-border p-4 hover:border-white/20"
              >
                <span class="text-xs text-fg-subtle">较新的文章</span>

                <span class="mt-2 block text-sm text-fg-muted group-hover:text-fg">
                  ← {newerPost.data.title}
                </span>
              </a>
            )}
          </div>

          <div>
            {olderPost && (
              <a
                href={`/blog/${olderPost.id}`}
                class="group block rounded-xl border focus-ring border-border p-4 text-right hover:border-white/20"
              >
                <span class="text-xs text-fg-subtle">较早的文章</span>

                <span class="mt-2 block text-sm text-fg-muted group-hover:text-fg">
                  {olderPost.data.title} →
                </span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</BaseLayout>
