---
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import SEO from '@/components/seo/SEO.astro';

import { siteConfig } from '../config/site';

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const { title, description, noindex = false, type = 'website' } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang={siteConfig.locale} data-theme="dark" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="generator" content={Astro.generator} />

    <meta name="color-scheme" content="light dark" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      type={type}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline>
      (() => {
        const root = document.documentElement;

        let preference = 'system';

        try {
          const storedTheme = localStorage.getItem('theme');

          if (storedTheme === 'light' || storedTheme === 'dark') {
            preference = storedTheme;
          }
        } catch {
          /* empty */
        }

        const resolvedTheme =
          preference === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : preference;

        root.dataset.theme = resolvedTheme;
        root.dataset.themePreference = preference;
        root.style.colorScheme = resolvedTheme;
      })();
    </script>
  </head>

  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-black"
    >
      跳转到主要内容
    </a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
