---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Zhou | Frontend Developer",
  description = "Frontend engineer, builder and technical writer."
} = Astro.props;
---

<!doctype html>

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta
      name="description"
      content={description}
    />

    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>
  </body>
</html>