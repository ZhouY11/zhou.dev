---
import { siteConfig } from '../../config/site';
import SearchIsland from '../search/SearchIsland.astro';
import ThemeSwitcher from '../theme/ThemeSwitcher.astro';

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/';
  }

  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-6">
    <div class="flex w-full items-center justify-between gap-8 md:justify-normal">
      <a
        href="/"
        class="text-lg font-semibold tracking-tight text-fg focus-ring"
        aria-label="返回首页"
      >
        {siteConfig.name}<span class="text-accent">.</span>
      </a>

      <SearchIsland />
    </div>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      <ThemeSwitcher />

      <div class="mx-2 h-4 w-px bg-border" aria-hidden="true"></div>

      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 text-sm text-fg-muted focus-ring transition-colors duration-200 hover:bg-bg-muted hover:text-fg',
              isActive(item.href) ? 'bg-bg-muted text-fg' : 'text-fg-muted hover:text-fg',
            ]}
          >
            {item.label}
          </a>
        ))
      }

      <div class="mx-2 h-4 w-px bg-border" aria-hidden="true"></div>

      <a
        href={siteConfig.links.github}
        target="_blank"
        rel="noreferrer"
        class="rounded-lg px-3 py-2 text-sm text-fg-muted focus-ring transition-colors duration-200 hover:bg-bg-muted hover:text-fg"
      >
        GitHub
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="cursor-pointer list-none rounded-lg border border-border px-3 py-2 text-sm text-fg-muted"
      >
        Menu
      </summary>

      <nav
        class="absolute top-12 right-0 min-w-40 rounded-xl border border-border bg-bg p-2 shadow-2xl"
        aria-label="移动端导航"
      >
        {
          siteConfig.nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-3 py-2 text-sm',
                isActive(item.href) ? 'bg-bg-muted text-fg' : 'text-fg-muted',
              ]}
            >
              {item.label}
            </a>
          ))
        }

        <a
          href={siteConfig.links.github}
          target="_blank"
          rel="noreferrer"
          class="block rounded-lg px-3 py-2 text-sm text-fg-muted"
        >
          GitHub
        </a>
      </nav>
    </details>
  </div>
</header>
