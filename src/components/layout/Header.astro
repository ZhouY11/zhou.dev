---
import { siteConfig } from '../../config/site';

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/';
  }

  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-zinc-950/70 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="text-lg font-semibold tracking-tight text-white" aria-label="返回首页">
      {siteConfig.name}<span class="text-indigo-400">.</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 text-sm transition-colors',
              isActive(item.href) ? 'bg-white/5 text-white' : 'text-zinc-400 hover:text-white',
            ]}
          >
            {item.label}
          </a>
        ))
      }

      <div class="mx-2 h-4 w-px bg-white/10" aria-hidden="true"></div>

      <a
        href={siteConfig.links.github}
        target="_blank"
        rel="noreferrer"
        class="rounded-lg px-3 py-2 text-sm text-zinc-400 transition-colors hover:text-white"
      >
        GitHub
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="cursor-pointer list-none rounded-lg border border-white/10 px-3 py-2 text-sm text-zinc-300"
      >
        Menu
      </summary>

      <nav
        class="absolute top-12 right-0 min-w-40 rounded-xl border border-white/10 bg-zinc-950 p-2 shadow-2xl"
        aria-label="移动端导航"
      >
        {
          siteConfig.nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-3 py-2 text-sm',
                isActive(item.href) ? 'bg-white/5 text-white' : 'text-zinc-400',
              ]}
            >
              {item.label}
            </a>
          ))
        }

        <a
          href={siteConfig.links.github}
          target="_blank"
          rel="noreferrer"
          class="block rounded-lg px-3 py-2 text-sm text-zinc-400"
        >
          GitHub
        </a>
      </nav>
    </details>
  </div>
</header>
