---
import type { Project } from '../../data/projects';

import ProjectShowcaseIsland from '../projects/ProjectShowcaseIsland.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" class="scroll-mt-24 border-y border-border bg-bg-elevated">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <SectionHeading
      eyebrow="Projects"
      title="项目与实践"
      description="一些关于前端工程、开发工具和 AI 应用的长期实践。"
    />

    <div class="mt-12">
      <ProjectShowcaseIsland projects={projects} />
    </div>
  </div>
</section>
