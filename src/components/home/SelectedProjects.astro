---
import type { ProjectSummary } from '@/types/project';

import ProjectShowcaseIsland from '../projects/ProjectShowcaseIsland.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  projects: ProjectSummary[];
}

const { projects } = Astro.props;
---

<section id="projects" class="scroll-mt-24 border-y border-border bg-bg-elevated">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="flex items-end justify-between gap-8">
      <SectionHeading
        eyebrow="Selected Work"
        title="一些真实项目中的工程实践。"
        description="比起只展示技术栈，我更希望记录问题、约束、技术决策，以及方案最终带来的变化。"
      />

      <a
        href="/projects"
        class="hidden focus-ring text-sm text-fg-muted transition-colors hover:text-fg sm:block"
      >
        查看全部
        <span aria-hidden="true"> →</span>
      </a>
    </div>

    <div class="mt-12">
      <ProjectShowcaseIsland projects={projects} />
    </div>
  </div>
</section>
