---
import type { CollectionEntry } from 'astro:content';

import { formatDate } from '../../lib/date';
import SectionHeading from './SectionHeading.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-24">
  <div class="flex items-end justify-between gap-8">
    <SectionHeading
      eyebrow="Featured"
      title="精选文章"
      description="关于前端架构、工程化、性能与 AI 应用的一些实践和思考。"
    />

    <a href="/blog" class="hidden text-sm text-fg-muted transition-colors hover:text-fg sm:block">
      查看全部
      <span aria-hidden="true"> →</span>
    </a>
  </div>

  {
    posts.length > 0 ? (
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="h-full">
            <a
              href={`/blog/${post.id}`}
              class="group flex h-full flex-col rounded-2xl border border-border bg-bg-elevated p-6 transition-colors hover:border-border hover:bg-bg-muted"
            >
              <div class="flex flex-wrap gap-2">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="text-xs font-medium text-accent">#{tag}</span>
                ))}
              </div>

              <h3 class="mt-5 text-xl font-semibold tracking-tight text-fg transition-colors group-hover:text-accent">
                {post.data.title}
              </h3>

              <p class="mt-3 flex-1 leading-7 text-fg-muted">{post.data.description}</p>

              <time
                datetime={post.data.publishedAt.toISOString()}
                class="mt-6 block text-sm text-fg-subtle"
              >
                {formatDate(post.data.publishedAt)}
              </time>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="mt-10 text-fg-subtle">暂时还没有精选文章。</p>
    )
  }

  <a
    href="/blog"
    class="mt-8 inline-block text-sm text-fg-muted transition-colors hover:text-fg sm:hidden"
  >
    查看全部
    <span aria-hidden="true"> →</span>
  </a>
</section>
