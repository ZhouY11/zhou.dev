---
import type { CollectionEntry } from 'astro:content';

import SectionHeading from './SectionHeading.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-24">
  <div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
    <div>
      <SectionHeading
        eyebrow="Selected Writing"
        title="写下技术决策，也写下踩过的坑。"
        description="这里主要记录前端架构、工程化、性能优化，以及我正在学习的 AI Agent。"
      />

      <a
        href="/blog"
        class="mt-8 inline-flex items-center rounded-md focus-ring text-sm font-medium text-fg-muted transition-colors hover:text-fg"
      >
        查看全部
        <span class="ml-2" aria-hidden="true">→</span>
      </a>
    </div>
    <div class="border-t border-border">
      {
        posts.map(({ id, data }) => (
          <article class="border-b border-border py-7">
            <a href={`/blog/${id}`} class="group block focus:outline-none">
              <h3 class="inline rounded-md focus-ring text-xl font-medium tracking-tight text-fg transition-colors group-hover:text-brand">
                {data.title}
              </h3>

              <p class="mt-3 line-clamp-2 text-sm leading-7 text-fg-muted">{data.description}</p>

              <div class="mt-4 flex flex-wrap gap-2">
                {data.tags.slice(0, 3).map((tag) => (
                  <span class="text-xs text-fg-subtle">#{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
