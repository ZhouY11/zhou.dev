---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group relative overflow-hidden rounded-2xl border border-border bg-bg-elevated p-6 transition duration-300 ease-fluid hover:-translate-y-1 hover:border-accent/30 hover:shadow-xl motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <div
    class="pointer-events-none absolute -top-24 -right-24 size-48 rounded-full bg-accent-soft opacity-0 blur-3xl transition-opacity duration-300 group-hover:opacity-100 motion-reduce:transition-none"
    aria-hidden="true"
  >
  </div>

  <div class="relative flex h-full flex-col">
    <div class="flex flex-wrap gap-2">
      {
        project.tags.map((tag) => (
          <span class="rounded-full border border-border px-2.5 py-1 text-xs text-fg-muted">
            {tag}
          </span>
        ))
      }
    </div>

    <h3
      class="mt-6 text-xl font-semibold tracking-tight text-fg transition-colors group-hover:text-accent"
    >
      {project.title}
    </h3>

    <p class="mt-3 flex-1 leading-7 text-fg-muted">
      {project.description}
    </p>

    <div class="mt-6 flex items-center gap-4 text-sm">
      {
        project.href && (
          <a
            href={project.href}
            target="_blank"
            rel="noreferrer"
            class="text-fg focus-ring transition-colors hover:text-accent"
          >
            View Project
            <span aria-hidden="true"> ↗</span>
          </a>
        )
      }

      {
        project.repository && (
          <a
            href={project.repository}
            target="_blank"
            rel="noreferrer"
            class="text-fg-subtle focus-ring transition-colors hover:text-fg"
          >
            Source
            <span aria-hidden="true"> ↗</span>
          </a>
        )
      }
    </div>
  </div>
</article>
