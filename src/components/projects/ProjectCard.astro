---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/2 p-6 transition-colors hover:border-white/20 hover:bg-white/4"
>
  <div
    class="pointer-events-none absolute -top-24 -right-24 size-48 rounded-full bg-indigo-500/10 blur-3xl transition-opacity group-hover:opacity-100"
    aria-hidden="true"
  >
  </div>

  <div class="relative flex h-full flex-col">
    <div class="flex flex-wrap gap-2">
      {
        project.tags.map((tag) => (
          <span class="rounded-full border border-white/10 px-2.5 py-1 text-xs text-zinc-400">
            {tag}
          </span>
        ))
      }
    </div>

    <h3 class="mt-6 text-xl font-semibold tracking-tight text-white">
      {project.title}
    </h3>

    <p class="mt-3 flex-1 leading-7 text-zinc-400">
      {project.description}
    </p>

    <div class="mt-6 flex items-center gap-4 text-sm">
      {
        project.href && (
          <a
            href={project.href}
            target="_blank"
            rel="noreferrer"
            class="text-white transition-colors hover:text-indigo-300"
          >
            View Project
            <span aria-hidden="true"> ↗</span>
          </a>
        )
      }

      {
        project.repository && (
          <a
            href={project.repository}
            target="_blank"
            rel="noreferrer"
            class="text-zinc-500 transition-colors hover:text-white"
          >
            Source
            <span aria-hidden="true"> ↗</span>
          </a>
        )
      }
    </div>
  </div>
</article>
