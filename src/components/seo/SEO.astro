---
import { ogConfig } from '@/config/og';
import { siteConfig } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: URL | string;
  noindex?: boolean;
  type?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description = siteConfig.description,
  canonical,
  noindex = false,
  type = 'website',
  ogImage = ogConfig.ogImageSite,
  ogImageAlt = `${title} — ${siteConfig.name}`,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.title;

const rssURL = Astro.site ? new URL('/rss.xml', Astro.site) : undefined;

const ogImageURL = Astro.site ? new URL(ogImage, Astro.site) : undefined;
---

<title>{pageTitle}</title>

<meta name="description" content={description} />

{canonical && <link rel="canonical" href={canonical} />}

{
  rssURL && (
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS Feed`}
      href={rssURL}
    />
  )
}

{noindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:title" content={pageTitle} />

<meta property="og:description" content={description} />

<meta property="og:type" content={type} />

{canonical && <meta property="og:url" content={canonical} />}

<meta property="og:locale" content={siteConfig.locale.replace('-', '_')} />

{
  ogImage && (
    <>
      <meta property="og:image" content={ogImageURL} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:alt" content={ogImageAlt} />

      <meta name="twitter:image" content={ogImageURL} />
      <meta name="twitter:image:alt" content={ogImageAlt} />
    </>
  )
}

<meta name="twitter:card" content="summary" />

<meta name="google-site-verification" content="E_UuA5Hi9bOgNgcNbDdUtwgEIRs4PcCU6iKxJrhJ3is" />
